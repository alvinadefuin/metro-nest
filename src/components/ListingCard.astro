---
interface Props {
  title: string;
  location: string;
  price: string;
  period?: string;
  beds: string;
  baths: number;
  area: string;
  image: string;
  tag?: string;
  href?: string;
}

const {
  title,
  location,
  price,
  period = "/month",
  beds,
  baths,
  area,
  image,
  tag,
  href = "#"
} = Astro.props;
---

<article class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2">
  <!-- Image Container -->
  <div class="relative overflow-hidden">
    <img
      src={image}
      alt=""
      class="w-full h-48 sm:h-52 object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    {tag && (
      <div class="absolute top-3 left-3">
        <span class="bg-white/95 backdrop-blur-sm text-gray-900 px-3 py-1 rounded-full text-xs font-medium shadow-sm">
          {tag}
        </span>
      </div>
    )}
    <!-- Favorite button -->
    <button
      type="button"
      class="absolute top-3 right-3 w-9 h-9 bg-white/95 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all shadow-sm hover:bg-white hover:scale-110 focus:opacity-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      aria-label={`Add ${title} to favorites`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-600 hover:text-red-500 transition-colors" aria-hidden="true">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
      </svg>
    </button>
  </div>

  <!-- Content -->
  <div class="p-4 sm:p-5">
    <div class="flex items-start justify-between mb-2">
      <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors line-clamp-1 text-sm sm:text-base">
        <a href={href} class="after:absolute after:inset-0 focus:outline-none">
          {title}
        </a>
      </h3>
    </div>

    <!-- Location -->
    <div class="flex items-center gap-1 text-gray-500 text-xs sm:text-sm mb-3 sm:mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <span class="line-clamp-1">{location}</span>
    </div>

    <!-- Amenities -->
    <div class="flex items-center gap-3 sm:gap-4 text-xs sm:text-sm text-gray-600 mb-3 sm:mb-4">
      <span class="flex items-center gap-1" aria-label={`${beds}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 4v16"></path>
          <path d="M2 8h18a2 2 0 0 1 2 2v10"></path>
          <path d="M2 17h20"></path>
          <path d="M6 8v9"></path>
        </svg>
        <span>{beds}</span>
      </span>
      <span class="flex items-center gap-1" aria-label={`${baths} bathroom${baths > 1 ? 's' : ''}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"></path>
          <line x1="10" x2="8" y1="5" y2="7"></line>
          <line x1="2" x2="22" y1="12" y2="12"></line>
          <line x1="7" x2="7" y1="19" y2="21"></line>
          <line x1="17" x2="17" y1="19" y2="21"></line>
        </svg>
        <span>{baths}</span>
      </span>
      <span class="flex items-center gap-1" aria-label={`${area} floor area`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2"></rect>
        </svg>
        <span>{area}</span>
      </span>
    </div>

    <!-- Price and CTA -->
    <div class="flex items-center justify-between pt-3 sm:pt-4 border-t border-gray-100">
      <div>
        <span class="text-xl sm:text-2xl font-bold text-blue-600">{price}</span>
        <span class="text-gray-500 text-xs sm:text-sm">{period}</span>
      </div>
      <span class="text-blue-600 font-medium text-xs sm:text-sm group-hover:underline">
        View Details
        <span class="sr-only">for {title}</span>
      </span>
    </div>
  </div>
</article>
