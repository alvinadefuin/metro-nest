---
const areas = ["All Areas", "BGC, Taguig", "Makati", "Ortigas, Pasig", "Mandaluyong"];
const unitTypes = ["Any Type", "Studio", "1 Bedroom", "2 Bedrooms", "3 Bedrooms"];
const contractLengths = ["6 months", "1 year"];
---

<div class="bg-white rounded-2xl shadow-xl p-4 md:p-6 max-w-4xl mx-auto">
  <form class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <!-- Location Select -->
    <div class="md:col-span-1">
      <label for="location" class="block text-xs font-medium text-gray-500 mb-1.5">Location</label>
      <select
        id="location"
        name="location"
        class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all cursor-pointer"
      >
        {areas.map((area) => (
          <option value={area}>{area}</option>
        ))}
      </select>
    </div>

    <!-- Unit Type Select -->
    <div class="md:col-span-1">
      <label for="unit-type" class="block text-xs font-medium text-gray-500 mb-1.5">Unit Type</label>
      <select
        id="unit-type"
        name="unit-type"
        class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all cursor-pointer"
      >
        {unitTypes.map((type) => (
          <option value={type}>{type}</option>
        ))}
      </select>
    </div>

    <!-- Contract Length Select -->
    <div class="md:col-span-1">
      <label for="contract" class="block text-xs font-medium text-gray-500 mb-1.5">Contract Length</label>
      <select
        id="contract"
        name="contract"
        class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all cursor-pointer"
      >
        {contractLengths.map((length) => (
          <option value={length}>{length}</option>
        ))}
      </select>
    </div>

    <!-- Search Button -->
    <div class="md:col-span-1 flex items-end">
      <button
        type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-medium transition-all hover:shadow-lg hover:shadow-blue-500/25 flex items-center justify-center gap-2 group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        Search
      </button>
    </div>
  </form>
</div>
