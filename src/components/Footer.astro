---
const quickLinks = [
  { href: "/listings", label: "Browse Listings" },
  { href: "/#about", label: "About Us" },
  { href: "/contact", label: "Contact" }
];

const areas = [
  { href: "/areas/bgc", label: "BGC, Taguig" },
  { href: "/areas/makati", label: "Makati" },
  { href: "/areas/ortigas", label: "Ortigas, Pasig" },
  { href: "/areas/mandaluyong", label: "Mandaluyong" }
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-400 py-10 sm:py-12 px-4" role="contentinfo">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4 group focus-ring rounded-lg w-fit" aria-label="MetroNest Home">
          <div class="w-8 h-8 bg-gradient-to-br from-blue-600 to-blue-700 rounded-lg flex items-center justify-center" aria-hidden="true">
            <span class="text-white font-bold text-sm">M</span>
          </div>
          <span class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">MetroNest</span>
        </a>
        <p class="text-sm leading-relaxed mb-4">
          Your trusted partner in finding the perfect condo rental in Metro Manila.
        </p>
        <!-- Social Links -->
        <nav aria-label="Social media links">
          <ul class="flex gap-3">
            <li>
              <a href="#" class="w-9 h-9 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-colors focus-ring" aria-label="Follow us on Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            </li>
            <li>
              <a href="#" class="w-9 h-9 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-colors focus-ring" aria-label="Follow us on Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                </svg>
              </a>
            </li>
            <li>
              <a href="#" class="w-9 h-9 bg-gray-800 hover:bg-blue-600 rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-colors focus-ring" aria-label="Follow us on LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect width="4" height="12" x="2" y="9"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Quick Links -->
      <nav aria-label="Quick links">
        <h3 class="text-white font-semibold mb-3 sm:mb-4 text-sm sm:text-base">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors focus-ring rounded">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Areas -->
      <nav aria-label="Browse by area">
        <h3 class="text-white font-semibold mb-3 sm:mb-4 text-sm sm:text-base">Areas</h3>
        <ul class="space-y-2 text-sm">
          {areas.map((area) => (
            <li>
              <a href={area.href} class="hover:text-white transition-colors focus-ring rounded">
                {area.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-3 sm:mb-4 text-sm sm:text-base">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="mailto:hello@metronest.ph" class="flex items-center gap-2 hover:text-white transition-colors focus-ring rounded group">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 group-hover:text-blue-400" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span>hello@metronest.ph</span>
            </a>
          </li>
          <li>
            <a href="tel:+639171234567" class="flex items-center gap-2 hover:text-white transition-colors focus-ring rounded group">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 group-hover:text-blue-400" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>+63 917 123 4567</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800 pt-6 sm:pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-center sm:text-left">
      <p>&copy; {currentYear} MetroNest. All rights reserved.</p>
      <nav aria-label="Legal">
        <ul class="flex gap-4 sm:gap-6">
          <li>
            <a href="#" class="hover:text-white transition-colors focus-ring rounded">Privacy Policy</a>
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors focus-ring rounded">Terms of Service</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
