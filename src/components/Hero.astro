---
import SearchBox from './SearchBox.astro';
---

<section class="pt-24 pb-16 px-4 bg-gradient-to-br from-slate-50 via-blue-50 to-slate-50 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-200/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-blue-100/40 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto relative">
    <div class="text-center mb-10">
      <!-- Trust badge -->
      <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-700 px-4 py-1.5 rounded-full text-sm font-medium mb-6">
        <span class="w-2 h-2 bg-blue-600 rounded-full animate-pulse"></span>
        Trusted by 500+ tenants in Metro Manila
      </div>

      <!-- Heading -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-4 leading-tight">
        Find Your Perfect
        <span class="text-blue-600 block">Condo in Manila</span>
      </h1>

      <!-- Subheading -->
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Flexible 6-month and 1-year leases for working professionals.
        Premium condos in BGC, Makati, and Ortigas.
      </p>
    </div>

    <!-- Search Box -->
    <SearchBox />

    <!-- Stats -->
    <div class="flex flex-wrap justify-center gap-8 mt-10 text-center">
      <div class="group">
        <div class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">200+</div>
        <div class="text-sm text-gray-500">Active Listings</div>
      </div>
      <div class="w-px h-12 bg-gray-200 hidden sm:block"></div>
      <div class="group">
        <div class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">500+</div>
        <div class="text-sm text-gray-500">Happy Tenants</div>
      </div>
      <div class="w-px h-12 bg-gray-200 hidden sm:block"></div>
      <div class="group">
        <div class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">4.9</div>
        <div class="text-sm text-gray-500">Rating</div>
      </div>
    </div>
  </div>
</section>
