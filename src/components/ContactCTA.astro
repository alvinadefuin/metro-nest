---
const WEB3FORMS_KEY = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<section id="contact" class="py-12 sm:py-16 px-4 bg-gradient-to-r from-blue-600 to-blue-700 relative overflow-hidden">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute -top-20 -right-20 w-40 sm:w-60 h-40 sm:h-60 bg-blue-500/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-40 sm:w-60 h-40 sm:h-60 bg-blue-400/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-4xl mx-auto relative">
    <div class="text-center mb-6 sm:mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-3 sm:mb-4">
        Ready to Find Your New Home?
      </h2>
      <p class="text-blue-100 max-w-2xl mx-auto text-base sm:text-lg">
        Let us know what you're looking for and we'll send you personalized recommendations within 24 hours.
      </p>
    </div>

    <!-- Quick Contact Form -->
    <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 sm:p-6 md:p-8 max-w-2xl mx-auto">
      <form id="cta-form" class="space-y-4" action="https://api.web3forms.com/submit" method="POST" novalidate>
        <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
        <input type="hidden" name="subject" value="New Condo Inquiry from MetroNest" />
        <input type="hidden" name="from_name" value="MetroNest Website" />
        <input type="checkbox" name="botcheck" class="hidden" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label for="cta-name" class="sr-only">Your name</label>
            <input
              type="text"
              id="cta-name"
              name="name"
              required
              placeholder="Your name"
              class="cta-input w-full px-4 py-3 bg-white/95 border-2 border-transparent rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:border-white focus:bg-white transition-all"
              aria-describedby="cta-name-error"
            />
            <p id="cta-name-error" class="hidden mt-1 text-sm text-red-200" role="alert"></p>
          </div>
          <div>
            <label for="cta-email" class="sr-only">Your email</label>
            <input
              type="email"
              id="cta-email"
              name="email"
              required
              placeholder="Your email"
              class="cta-input w-full px-4 py-3 bg-white/95 border-2 border-transparent rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:border-white focus:bg-white transition-all"
              aria-describedby="cta-email-error"
            />
            <p id="cta-email-error" class="hidden mt-1 text-sm text-red-200" role="alert"></p>
          </div>
        </div>
        <div>
          <label for="cta-phone" class="sr-only">Phone number (optional)</label>
          <input
            type="tel"
            id="cta-phone"
            name="phone"
            placeholder="Phone number (optional)"
            class="cta-input w-full px-4 py-3 bg-white/95 border-2 border-transparent rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:border-white focus:bg-white transition-all"
          />
        </div>
        <div>
          <label for="cta-message" class="sr-only">What are you looking for?</label>
          <textarea
            id="cta-message"
            name="message"
            rows="3"
            required
            placeholder="What are you looking for? (e.g., 1BR in Makati, budget ₱30k)"
            class="cta-input w-full px-4 py-3 bg-white/95 border-2 border-transparent rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:border-white focus:bg-white resize-none transition-all"
            aria-describedby="cta-message-error"
          ></textarea>
          <p id="cta-message-error" class="hidden mt-1 text-sm text-red-200" role="alert"></p>
        </div>
        <button
          type="submit"
          class="w-full bg-white text-blue-600 hover:bg-blue-50 py-3 rounded-xl font-semibold transition-all hover:shadow-lg flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed min-h-[48px]"
        >
          <span class="btn-text flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" x2="11" y1="2" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            Send Request
          </span>
          <span class="btn-loading hidden items-center gap-2">
            <span class="spinner" aria-hidden="true"></span>
            Sending...
          </span>
        </button>
      </form>

      <!-- Success State -->
      <div id="cta-success" class="hidden text-center py-6 animate-fade-in" role="status" aria-live="polite">
        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Request Sent!</h3>
        <p class="text-blue-100">We'll get back to you within 24 hours with personalized recommendations.</p>
      </div>

      <!-- Error State -->
      <div id="cta-error" class="hidden text-center py-6 animate-fade-in" role="alert" aria-live="assertive">
        <div class="w-14 h-14 bg-red-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="15" x2="9" y1="9" y2="15"></line>
            <line x1="9" x2="15" y1="9" y2="15"></line>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Something went wrong</h3>
        <p class="text-blue-100 mb-4">Please try again or contact us directly.</p>
        <button
          id="cta-retry"
          class="text-white underline hover:no-underline font-medium"
        >
          Try again
        </button>
      </div>
    </div>

    <!-- Alternative Contact -->
    <div class="mt-6 text-center">
      <p class="text-blue-100 text-sm">
        Prefer to talk? Call us at
        <a href="tel:+639171234567" class="text-white font-medium hover:underline focus-ring rounded">+63 917 123 4567</a>
        or visit our
        <a href="/contact" class="text-white font-medium hover:underline focus-ring rounded">contact page</a>
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('cta-form') as HTMLFormElement;
  const successMessage = document.getElementById('cta-success');
  const errorMessage = document.getElementById('cta-error');
  const retryBtn = document.getElementById('cta-retry');

  function validateEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function showFieldError(fieldId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement;
    const errorEl = document.getElementById(`${fieldId}-error`);

    if (field && errorEl) {
      field.classList.add('border-red-300', 'bg-red-50/50');
      field.classList.remove('border-transparent');
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function clearFieldError(fieldId: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement;
    const errorEl = document.getElementById(`${fieldId}-error`);

    if (field && errorEl) {
      field.classList.remove('border-red-300', 'bg-red-50/50');
      field.classList.add('border-transparent');
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }
  }

  function clearAllErrors() {
    ['cta-name', 'cta-email', 'cta-message'].forEach(clearFieldError);
  }

  function validateForm(): boolean {
    let isValid = true;
    clearAllErrors();

    const name = (document.getElementById('cta-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('cta-email') as HTMLInputElement)?.value.trim();
    const message = (document.getElementById('cta-message') as HTMLTextAreaElement)?.value.trim();

    if (!name) {
      showFieldError('cta-name', 'Please enter your name');
      isValid = false;
    }

    if (!email) {
      showFieldError('cta-email', 'Please enter your email');
      isValid = false;
    } else if (!validateEmail(email)) {
      showFieldError('cta-email', 'Please enter a valid email');
      isValid = false;
    }

    if (!message) {
      showFieldError('cta-message', 'Please tell us what you\'re looking for');
      isValid = false;
    }

    return isValid;
  }

  function setLoading(loading: boolean) {
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('.btn-text');
    const btnLoading = submitBtn?.querySelector('.btn-loading');

    if (submitBtn) {
      submitBtn.disabled = loading;
    }
    if (btnText) {
      btnText.classList.toggle('hidden', loading);
    }
    if (btnLoading) {
      btnLoading.classList.toggle('hidden', !loading);
      btnLoading.classList.toggle('flex', loading);
    }
  }

  function showSuccess() {
    form?.classList.add('hidden');
    errorMessage?.classList.add('hidden');
    successMessage?.classList.remove('hidden');
  }

  function showError() {
    form?.classList.add('hidden');
    successMessage?.classList.add('hidden');
    errorMessage?.classList.remove('hidden');
  }

  function resetForm() {
    form?.reset();
    clearAllErrors();
    form?.classList.remove('hidden');
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');
    setLoading(false);
  }

  // Add real-time validation on blur
  ['cta-name', 'cta-email', 'cta-message'].forEach(id => {
    const field = document.getElementById(id);
    field?.addEventListener('blur', () => {
      if ((field as HTMLInputElement).value.trim()) {
        clearFieldError(id);
      }
    });
    field?.addEventListener('input', () => {
      clearFieldError(id);
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!validateForm()) {
      // Focus first error field
      const firstError = form?.querySelector('.border-red-300') as HTMLElement;
      firstError?.focus();
      return;
    }

    setLoading(true);

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        showSuccess();
      } else {
        showError();
      }
    } catch (error) {
      showError();
    } finally {
      setLoading(false);
    }
  });

  retryBtn?.addEventListener('click', resetForm);
</script>
