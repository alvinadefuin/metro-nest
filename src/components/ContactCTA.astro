---
---

<section id="contact" class="py-16 px-4 bg-gradient-to-r from-blue-600 to-blue-700 relative overflow-hidden">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-20 -right-20 w-60 h-60 bg-blue-500/30 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-60 h-60 bg-blue-400/20 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-4xl mx-auto relative">
    <div class="text-center mb-8">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready to Find Your New Home?
      </h2>
      <p class="text-blue-100 max-w-2xl mx-auto text-lg">
        Let us know what you're looking for and we'll send you personalized recommendations within 24 hours.
      </p>
    </div>

    <!-- Quick Contact Form -->
    <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 md:p-8 max-w-2xl mx-auto">
      <form id="cta-form" class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
        <!-- Web3Forms Access Key - Replace with your own from https://web3forms.com -->
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
        <input type="hidden" name="subject" value="New Condo Inquiry from MetroNest" />
        <input type="hidden" name="from_name" value="MetroNest Website" />
        <input type="checkbox" name="botcheck" class="hidden" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <input
              type="text"
              name="name"
              required
              placeholder="Your name"
              class="w-full px-4 py-3 bg-white/90 border-0 rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white"
            />
          </div>
          <div>
            <input
              type="email"
              name="email"
              required
              placeholder="Your email"
              class="w-full px-4 py-3 bg-white/90 border-0 rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white"
            />
          </div>
        </div>
        <div>
          <input
            type="tel"
            name="phone"
            placeholder="Phone number (optional)"
            class="w-full px-4 py-3 bg-white/90 border-0 rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white"
          />
        </div>
        <div>
          <textarea
            name="message"
            rows="3"
            required
            placeholder="What are you looking for? (e.g., 1BR in Makati, budget ₱30k)"
            class="w-full px-4 py-3 bg-white/90 border-0 rounded-xl text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full bg-white text-blue-600 hover:bg-blue-50 py-3 rounded-xl font-semibold transition-all hover:shadow-lg flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" x2="11" y1="2" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          Send Request
        </button>
      </form>

      <!-- Success State -->
      <div id="cta-success" class="hidden text-center py-6">
        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Request Sent!</h3>
        <p class="text-blue-100">We'll get back to you within 24 hours with personalized recommendations.</p>
      </div>
    </div>

    <!-- Alternative Contact -->
    <div class="mt-6 text-center">
      <p class="text-blue-100 text-sm">
        Prefer to talk? Call us at
        <a href="tel:+639171234567" class="text-white font-medium hover:underline">+63 917 123 4567</a>
        or visit our
        <a href="/contact" class="text-white font-medium hover:underline">contact page</a>
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('cta-form') as HTMLFormElement;
  const successMessage = document.getElementById('cta-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn?.innerHTML;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Sending...';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      } else {
        alert('Something went wrong. Please try again.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      }
    } catch (error) {
      alert('Something went wrong. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    }
  });
</script>
