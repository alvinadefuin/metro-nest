---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const WEB3FORMS_KEY = import.meta.env.WEB3FORMS_ACCESS_KEY;
---

<Layout title="List Your Property - MetroNest" description="List your condo for rent on MetroNest. Reach thousands of potential tenants in Metro Manila.">
  <Navbar />

  <main id="main-content" class="pt-20">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-blue-600 to-blue-700 py-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">List Your Property</h1>
        <p class="text-blue-100 text-lg max-w-2xl mx-auto">
          Join hundreds of property owners who trust MetroNest to find quality tenants. Zero listing fees for property owners.
        </p>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-12 px-4 bg-white border-b border-gray-100">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">Verified Tenants</h3>
            <p class="text-sm text-gray-600">We screen all tenants for income and background</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">Fast Matching</h3>
            <p class="text-sm text-gray-600">Average listing time of just 2 weeks</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-1">Zero Listing Fees</h3>
            <p class="text-sm text-gray-600">Free to list, we only charge on successful rental</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Form Section -->
    <section class="py-12 px-4 bg-slate-50">
      <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-2xl shadow-sm p-6 md:p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-6">Property Details</h2>

          <form id="list-property-form" class="space-y-6" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="New Property Listing Submission" />
            <input type="hidden" name="from_name" value="MetroNest Property Listing" />
            <input type="checkbox" name="botcheck" class="hidden" />

            <!-- Owner Information -->
            <div class="space-y-4">
              <h3 class="font-medium text-gray-900">Your Information</h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="owner_name" class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                  <input
                    type="text"
                    id="owner_name"
                    name="owner_name"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="Juan dela Cruz"
                  />
                </div>
                <div>
                  <label for="owner_phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
                  <input
                    type="tel"
                    id="owner_phone"
                    name="owner_phone"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="+63 917 123 4567"
                  />
                </div>
              </div>

              <div>
                <label for="owner_email" class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label>
                <input
                  type="email"
                  id="owner_email"
                  name="owner_email"
                  required
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <hr class="border-gray-100" />

            <!-- Property Information -->
            <div class="space-y-4">
              <h3 class="font-medium text-gray-900">Property Information</h3>

              <div>
                <label for="property_title" class="block text-sm font-medium text-gray-700 mb-1">Property Title *</label>
                <input
                  type="text"
                  id="property_title"
                  name="property_title"
                  required
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="e.g., Modern 1BR in BGC with City View"
                />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label for="property_area" class="block text-sm font-medium text-gray-700 mb-1">Area *</label>
                  <select
                    id="property_area"
                    name="property_area"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">Select area</option>
                    <option value="bgc">BGC, Taguig</option>
                    <option value="makati">Makati</option>
                    <option value="ortigas">Ortigas, Pasig</option>
                    <option value="mandaluyong">Mandaluyong</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div>
                  <label for="property_address" class="block text-sm font-medium text-gray-700 mb-1">Building/Address *</label>
                  <input
                    type="text"
                    id="property_address"
                    name="property_address"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="e.g., One Bonifacio High Street"
                  />
                </div>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                  <label for="property_type" class="block text-sm font-medium text-gray-700 mb-1">Type *</label>
                  <select
                    id="property_type"
                    name="property_type"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">Select</option>
                    <option value="studio">Studio</option>
                    <option value="1br">1 Bedroom</option>
                    <option value="2br">2 Bedrooms</option>
                    <option value="3br">3 Bedrooms</option>
                  </select>
                </div>
                <div>
                  <label for="property_baths" class="block text-sm font-medium text-gray-700 mb-1">Bathrooms *</label>
                  <select
                    id="property_baths"
                    name="property_baths"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">Select</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3+</option>
                  </select>
                </div>
                <div>
                  <label for="property_sqm" class="block text-sm font-medium text-gray-700 mb-1">Size (sqm) *</label>
                  <input
                    type="number"
                    id="property_sqm"
                    name="property_sqm"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="45"
                  />
                </div>
                <div>
                  <label for="property_price" class="block text-sm font-medium text-gray-700 mb-1">Monthly Rent *</label>
                  <input
                    type="number"
                    id="property_price"
                    name="property_price"
                    required
                    class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="25000"
                  />
                </div>
              </div>

              <div>
                <label for="property_description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea
                  id="property_description"
                  name="property_description"
                  rows="4"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
                  placeholder="Describe your property, amenities, nearby landmarks..."
                ></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Furnishing *</label>
                <div class="flex flex-wrap gap-3">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="furnishing" value="fully" class="text-blue-600 focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">Fully Furnished</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="furnishing" value="semi" class="text-blue-600 focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">Semi-Furnished</span>
                  </label>
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="furnishing" value="bare" class="text-blue-600 focus:ring-blue-500" />
                    <span class="text-sm text-gray-700">Bare</span>
                  </label>
                </div>
              </div>
            </div>

            <hr class="border-gray-100" />

            <!-- Submit -->
            <div class="flex flex-col gap-4">
              <button
                type="submit"
                class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-medium transition-all hover:shadow-lg"
              >
                Submit Listing
              </button>
              <p class="text-sm text-gray-500 text-center">
                By submitting, you agree to our Terms of Service and Privacy Policy.
                Our team will review your listing within 24-48 hours.
              </p>
            </div>
          </form>

          <!-- Success Message (hidden by default) -->
          <div id="success-message" class="hidden text-center py-8">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Listing Submitted!</h3>
            <p class="text-gray-600 mb-4">Thank you! Our team will review your property and contact you within 24-48 hours.</p>
            <a href="/" class="text-blue-600 hover:text-blue-700 font-medium">← Back to Home</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('list-property-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn?.textContent;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
        successMessage?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('Something went wrong. Please try again.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      }
    } catch (error) {
      alert('Something went wrong. Please try again.');
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    }
  });
</script>
