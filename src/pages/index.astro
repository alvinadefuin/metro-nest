---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ListingCard from '../components/ListingCard.astro';
import AreaCard from '../components/AreaCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import { listings, areas } from '../data/listings';

// Get first 3 listings for featured section
const featuredListings = listings.slice(0, 3);

// Features data
const features = [
  {
    icon: "shield",
    title: "Verified Listings",
    description: "Every property is personally inspected. What you see is what you get."
  },
  {
    icon: "calendar",
    title: "Flexible Terms",
    description: "6-month and 1-year contracts available. Perfect for your career plans."
  },
  {
    icon: "heart",
    title: "Zero Broker Fees",
    description: "Tenants pay nothing. We're compensated by property owners."
  }
];

// Testimonials data
const testimonials = [
  {
    name: "Maria Santos",
    role: "Marketing Manager",
    text: "Found my perfect 1BR in Makati within a week. The team was super responsive and understood exactly what I needed for my budget.",
    rating: 5
  },
  {
    name: "James Rodriguez",
    role: "Software Developer",
    text: "As someone relocating from Cebu, having a reliable broker made all the difference. Highly recommend for hassle-free condo hunting!",
    rating: 5
  }
];
---

<Layout>
  <Navbar />

  <main>
    <!-- Hero Section -->
    <Hero />

    <!-- Featured Listings Section -->
    <section id="listings" class="py-16 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Featured Listings</h2>
            <p class="text-gray-600">Hand-picked condos ready for move-in</p>
          </div>
          <a
            href="/listings"
            class="text-blue-600 font-medium hover:text-blue-700 mt-4 md:mt-0 group inline-flex items-center gap-1"
          >
            View all listings
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {featuredListings.map((listing) => (
            <ListingCard
              title={listing.title}
              location={listing.location}
              price={listing.price}
              beds={listing.beds}
              baths={listing.baths}
              area={listing.sqm}
              image={listing.image}
              tag={listing.tag}
              href={`/listings/${listing.id}`}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Areas Section -->
    <section id="areas" class="py-16 px-4 bg-slate-50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Explore by Area</h2>
          <p class="text-gray-600">Find condos in Metro Manila's top business districts</p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {areas.map((area) => (
            <AreaCard
              name={area.name}
              count={area.count}
              image={area.image}
              slug={area.slug}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Why Choose Us Section -->
    <section id="about" class="py-16 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Why Choose MetroNest?</h2>
          <p class="text-gray-600">We make condo hunting stress-free for busy professionals</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {features.map((feature) => (
            <FeatureCard {...feature} />
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-16 px-4 bg-slate-50">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">What Our Clients Say</h2>
          <p class="text-gray-600">Real experiences from real tenants</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {testimonials.map((testimonial) => (
            <TestimonialCard {...testimonial} />
          ))}
        </div>
      </div>
    </section>

    <!-- Contact CTA Section -->
    <ContactCTA />
  </main>

  <Footer />
</Layout>
