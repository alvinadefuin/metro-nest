---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ListingCard from '../../components/ListingCard.astro';
import Footer from '../../components/Footer.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { areas, getListingsByArea, getAreaBySlug } from '../../data/listings';

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { area: area.slug },
    props: { area }
  }));
}

const { area } = Astro.props;
const areaListings = getListingsByArea(area.slug);
---

<Layout title={`Condos in ${area.name} - MetroNest`} description={`Find condo rentals in ${area.fullName}. ${area.description}`}>
  <Navbar />

  <main id="main-content" class="pt-20">
    <!-- Hero Section -->
    <section class="relative h-64 md:h-80">
      <img
        src={area.image}
        alt={area.name}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-transparent"></div>
      <div class="absolute inset-0 flex items-end">
        <div class="max-w-7xl mx-auto w-full px-4 pb-8">
          <nav class="flex items-center gap-2 text-sm text-white/80 mb-3">
            <a href="/" class="hover:text-white">Home</a>
            <span>/</span>
            <a href="/listings" class="hover:text-white">Listings</a>
            <span>/</span>
            <span class="text-white">{area.name}</span>
          </nav>
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">Condos in {area.name}</h1>
          <p class="text-white/90 max-w-2xl">{area.description}</p>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section class="bg-white border-b border-gray-100 py-4 px-4">
      <div class="max-w-7xl mx-auto flex flex-wrap gap-6 items-center justify-between">
        <div class="text-gray-600">
          <span class="font-semibold text-gray-900">{areaListings.length}</span> properties available in {area.fullName}
        </div>
        <div class="flex items-center gap-4">
          <select class="px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option>Sort by: Recommended</option>
            <option>Price: Low to High</option>
            <option>Price: High to Low</option>
            <option>Newest First</option>
          </select>
        </div>
      </div>
    </section>

    <!-- Listings Grid -->
    <section class="py-12 px-4 bg-slate-50">
      <div class="max-w-7xl mx-auto">
        {areaListings.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {areaListings.map((listing) => (
              <ListingCard
                title={listing.title}
                location={listing.location}
                price={listing.price}
                beds={listing.beds}
                baths={listing.baths}
                area={listing.sqm}
                image={listing.image}
                tag={listing.tag}
                href={`/listings/${listing.id}`}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <div class="text-gray-400 mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto">
                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">No listings available</h3>
            <p class="text-gray-600 mb-4">We don't have any listings in {area.name} right now.</p>
            <a href="/listings" class="text-blue-600 hover:text-blue-700 font-medium">
              Browse all listings →
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Other Areas -->
    <section class="py-12 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Explore Other Areas</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {areas.filter(a => a.slug !== area.slug).map((otherArea) => (
            <a href={`/areas/${otherArea.slug}`} class="group relative rounded-xl overflow-hidden aspect-[4/3]">
              <img
                src={otherArea.image}
                alt={otherArea.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-3 left-3 text-white">
                <h3 class="font-semibold">{otherArea.name}</h3>
                <p class="text-sm text-white/80">{otherArea.count} listings</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ContactCTA />
  </main>

  <Footer />
</Layout>
